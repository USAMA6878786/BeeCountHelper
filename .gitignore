# 构建中间产物
build/
build_out.txt

# 本地工具链（JDK / Android SDK，不进仓库）
toolchain/

# 编辑器 / 系统
.idea/
*.iml
.DS_Store
Thumbs.db

# 打包出来的 APK 走 GitHub Releases 分发，仓库里只保留源码
# （如果你想直接把 APK 提交进仓库，去掉下一行即可）
*.apk
*.idsig

# ⚠️ 签名密钥只保留在本地，绝不进仓库
#
# 它一旦公开，任何人都能签出和你一样的包（虽然对本模块的主要影响只是"别人能发同签名的包"）；
# 反过来更要紧的是：**这把密钥绝对不能丢**。丢了就没法再签出同签名的 APK，
# 已经装过的设备必须卸载重装——重装会连带清掉 root 授权和 LSPosed 作用域。
# 所以请单独备份一份。
*.jks
*.keystore
*.bks
*.p12
