<?xml version="1.0" encoding="utf-8"?>
<!--
  横向拉长后的布局：三项数据变成左中右三列。
  注意：id 与竖版布局**完全一致**（w_day_label / w_day_value …），
  这样渲染代码只用一套 id，切换布局时只换 layout 资源。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/w_day_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="今日支出"
                android:maxLines="1"
                android:textColor="#8A8A8E"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/w_day_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="2dp"
                android:text="—"
                android:textStyle="bold"
                android:textColor="#222222"
                android:textSize="12sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:background="#14000000" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/w_week_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="本周支出"
                android:maxLines="1"
                android:textColor="#8A8A8E"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/w_week_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="2dp"
                android:text="—"
                android:textStyle="bold"
                android:textColor="#222222"
                android:textSize="12sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:background="#14000000" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/w_month_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="本月支出"
                android:maxLines="1"
                android:textColor="#8A8A8E"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/w_month_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="2dp"
                android:text="—"
                android:textStyle="bold"
                android:textColor="#222222"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
